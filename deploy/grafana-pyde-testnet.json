  "description": "Pyde testnet operator dashboard. Pairs 1:1 with docs/oncall.md — every panel that can alert references a runbook row.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
