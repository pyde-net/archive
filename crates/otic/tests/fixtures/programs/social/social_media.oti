// Decentralized social media platform with posts, likes, and reputation scoring
use std::math;

contract SocialMedia {
    storage {
        owner: Address,
        next_post_id: u64,
        posts: Map<u64, Post>,
        user_profiles: Map<Address, Profile>,
        post_likes: Map<u64, Map<Address, bool>>,
        like_counts: Map<u64, u64>,
        reputation: Map<Address, u256>,
        flagged_posts: Map<u64, u32>,
        moderators: Map<Address, bool>,
        report_threshold: u32,
        total_users: u64,
    }

    struct Post {
        author: Address,
        content_hash: u256,
        timestamp: u64,
        parent_id: u64,
        is_reply: bool,
        deleted: bool,
        edit_count: u8,
    }

    struct Profile {
        handle: String,
        bio_hash: u256,
        registered_at: u64,
        post_count: u64,
        active: bool,
    }

    event PostCreated {
        #[indexed]
        post_id: u64,
        #[indexed]
        author: Address,
        content_hash: u256,
    }

    event PostLiked {
        #[indexed]
        post_id: u64,
        #[indexed]
        liker: Address,
    }

    event PostUnliked {
        #[indexed]
        post_id: u64,
        #[indexed]
        unliker: Address,
    }

    event ProfileRegistered {
        #[indexed]
        user: Address,
        handle: String,
    }

    event PostFlagged {
        #[indexed]
        post_id: u64,
        flag_count: u32,
    }

    event PostDeleted {
        #[indexed]
        post_id: u64,
    }

    event ReputationUpdated {
        #[indexed]
        user: Address,
        new_score: u256,
    }

    error NotRegistered {}
    error AlreadyRegistered {}
    error PostNotFound { post_id: u64 }
    error PostDeleted { post_id: u64 }
    error AlreadyLiked {}
    error NotLiked {}
    error NotAuthor {}
    error NotModerator {}
    error HandleTaken {}
    error MaxEditsReached { max: u8 }
    error EmptyContent {}

    const MAX_EDITS: u8 = 5;
    const REPUTATION_REPLY_BOOST: u256 = 2;
    const REPUTATION_LIKE_BOOST: u256 = 1;
    const FLAG_REPUTATION_PENALTY: u256 = 50;
    const INITIAL_REPUTATION: u256 = 100;

    #[constructor]
    pub fn init(report_threshold: u32) {
        self.owner = msg.sender;
        self.next_post_id = 1;
        self.report_threshold = report_threshold;
        self.total_users = 0;
        self.moderators[msg.sender] = true;
    }

    pub fn register(handle: String, bio_hash: u256) {
        require!(!self.user_profiles[msg.sender].active, AlreadyRegistered {});

        let profile = Profile {
            handle: handle,
            bio_hash: bio_hash,
            registered_at: block.timestamp,
            post_count: 0,
            active: true,
        };
        self.user_profiles[msg.sender] = profile;
        self.reputation[msg.sender] = INITIAL_REPUTATION;
        self.total_users += 1;

        emit ProfileRegistered { user: msg.sender, handle: handle };
    }

    fn require_registered() {
        require!(self.user_profiles[msg.sender].active, NotRegistered {});
    }

    fn require_post_exists(post_id: u64) {
        require!(post_id > 0 && post_id < self.next_post_id, PostNotFound { post_id: post_id });
        require!(!self.posts[post_id].deleted, PostDeleted { post_id: post_id });
    }

    pub fn create_post(content_hash: u256) {
        self.require_registered();
        require!(content_hash != 0, EmptyContent {});

        let post_id = self.next_post_id;
        self.next_post_id += 1;

        let post = Post {
            author: msg.sender,
            content_hash: content_hash,
            timestamp: block.timestamp,
            parent_id: 0,
            is_reply: false,
            deleted: false,
            edit_count: 0,
        };
        self.posts[post_id] = post;
        self.user_profiles[msg.sender].post_count += 1;

        emit PostCreated { post_id: post_id, author: msg.sender, content_hash: content_hash };
    }

    pub fn reply_to(parent_id: u64, content_hash: u256) {
        self.require_registered();
        self.require_post_exists(parent_id);
        require!(content_hash != 0, EmptyContent {});

        let post_id = self.next_post_id;
        self.next_post_id += 1;

        let reply = Post {
            author: msg.sender,
            content_hash: content_hash,
            timestamp: block.timestamp,
            parent_id: parent_id,
            is_reply: true,
            deleted: false,
            edit_count: 0,
        };
        self.posts[post_id] = reply;
        self.user_profiles[msg.sender].post_count += 1;

        // Author of parent gets reputation boost
        let parent_author = self.posts[parent_id].author;
        self.reputation[parent_author] += 2;

        emit PostCreated { post_id: post_id, author: msg.sender, content_hash: content_hash };
        emit ReputationUpdated { user: parent_author, new_score: self.reputation[parent_author] };
    }

    pub fn like_post(post_id: u64) {
        self.require_registered();
        self.require_post_exists(post_id);
        require!(!self.post_likes[post_id][msg.sender], AlreadyLiked {});

        self.post_likes[post_id][msg.sender] = true;
        self.like_counts[post_id] += 1;

        let author = self.posts[post_id].author;
        self.reputation[author] += 1;

        emit PostLiked { post_id: post_id, liker: msg.sender };
        emit ReputationUpdated { user: author, new_score: self.reputation[author] };
    }

    pub fn unlike_post(post_id: u64) {
        self.require_registered();
        self.require_post_exists(post_id);
        require!(self.post_likes[post_id][msg.sender], NotLiked {});

        self.post_likes[post_id][msg.sender] = false;
        self.like_counts[post_id] -= 1;

        let author = self.posts[post_id].author;
        if self.reputation[author] > 0 {
            self.reputation[author] -= 1;
        }

        emit PostUnliked { post_id: post_id, unliker: msg.sender };
    }

    pub fn edit_post(post_id: u64, new_content_hash: u256) {
        self.require_post_exists(post_id);
        require!(self.posts[post_id].author == msg.sender, NotAuthor {});
        require!(self.posts[post_id].edit_count < MAX_EDITS, MaxEditsReached { max: MAX_EDITS });

        self.posts[post_id].content_hash = new_content_hash;
        self.posts[post_id].edit_count += 1;
    }

    pub fn flag_post(post_id: u64) {
        self.require_registered();
        self.require_post_exists(post_id);

        self.flagged_posts[post_id] += 1;
        let flags = self.flagged_posts[post_id];

        emit PostFlagged { post_id: post_id, flag_count: flags };

        if flags >= self.report_threshold {
            self.posts[post_id].deleted = true;
            let author = self.posts[post_id].author;
            if self.reputation[author] >= 50 {
                self.reputation[author] -= 50;
            } else {
                self.reputation[author] = 0;
            }
            emit PostDeleted { post_id: post_id };
        }
    }

    pub fn add_moderator(account: Address) {
        require!(msg.sender == self.owner, NotModerator {});
        self.moderators[account] = true;
    }

    pub fn moderate_delete(post_id: u64) {
        require!(self.moderators[msg.sender], NotModerator {});
        self.require_post_exists(post_id);

        self.posts[post_id].deleted = true;
        emit PostDeleted { post_id: post_id };
    }

    #[view]
    pub fn get_reputation(user: Address) -> u256 {
        return self.reputation[user];
    }

    #[view]
    pub fn get_like_count(post_id: u64) -> u64 {
        return self.like_counts[post_id];
    }

    #[view]
    pub fn get_post(post_id: u64) -> Post {
        return self.posts[post_id];
    }

    #[view]
    pub fn get_profile(user: Address) -> Profile {
        return self.user_profiles[user];
    }

    #[view]
    pub fn get_total_posts() -> u64 {
        return self.next_post_id - 1;
    }
}
