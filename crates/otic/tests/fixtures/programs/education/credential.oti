// Verifiable educational credentials with revocation and credential stacking

contract CredentialSystem {
    storage {
        governance: Address,
        next_credential_id: u64,
        credentials: Map<u64, Credential>,
        institutions: Map<Address, Institution>,
        student_credentials: Map<Address, Vec<u64>>,
        credential_prerequisites: Map<u64, Vec<u64>>,
        revocations: Map<u64, RevocationInfo>,
        skill_endorsements: Map<Address, Map<u256, u32>>,
        transcript_hashes: Map<Address, Map<Address, u256>>,
        credential_templates: Map<u32, CredentialTemplate>,
        template_count: u32,
    }

    struct Credential {
        institution: Address,
        recipient: Address,
        template_id: u32,
        achievement_hash: u256,
        metadata_hash: u256,
        issued_at: u64,
        expires_at: u64,
        grade_points_x100: u16,
        credits: u16,
        level: u8,
        active: bool,
    }

    struct Institution {
        name_hash: u256,
        accreditation_hash: u256,
        country_code: u16,
        registered: bool,
        credentials_issued: u64,
        accredited_until: u64,
    }

    struct RevocationInfo {
        revoked: bool,
        revoked_at: u64,
        reason_hash: u256,
        revoked_by: Address,
    }

    struct CredentialTemplate {
        name_hash: u256,
        category: u8,
        min_credits: u16,
        level: u8,
        institution: Address,
    }

    event CredentialIssued {
        #[indexed]
        credential_id: u64,
        #[indexed]
        institution: Address,
        #[indexed]
        recipient: Address,
    }

    event CredentialRevoked {
        #[indexed]
        credential_id: u64,
        reason_hash: u256,
    }

    event InstitutionRegistered {
        #[indexed]
        institution: Address,
        name_hash: u256,
    }

    event SkillEndorsed {
        #[indexed]
        recipient: Address,
        skill_hash: u256,
        count: u32,
    }

    event TranscriptShared {
        #[indexed]
        student: Address,
        #[indexed]
        viewer: Address,
    }

    error NotGovernance {}
    error InstitutionNotRegistered {}
    error AccreditationExpired {}
    error CredentialNotFound { id: u64 }
    error NotIssuer {}
    error AlreadyRevoked {}
    error PrerequisiteNotMet { required_id: u64 }
    error AlreadyRegistered {}
    error InsufficientCredits { required: u16, earned: u16 }

    const SECONDS_PER_DAY: u64 = 86400;
    const DAYS_PER_YEAR: u64 = 365;

    #[constructor]
    pub fn init() {
        self.governance = msg.sender;
        self.next_credential_id = 1;
        self.template_count = 0;
    }

    pub fn register_institution(
        institution: Address,
        name_hash: u256,
        accreditation_hash: u256,
        country_code: u16,
        accredited_years: u64,
    ) {
        require!(msg.sender == self.governance, NotGovernance {});
        require!(!self.institutions[institution].registered, AlreadyRegistered {});

        self.institutions[institution] = Institution {
            name_hash: name_hash,
            accreditation_hash: accreditation_hash,
            country_code: country_code,
            registered: true,
            credentials_issued: 0,
            accredited_until: block.timestamp + (accredited_years * 365 * 86400),
        };

        emit InstitutionRegistered { institution: institution, name_hash: name_hash };
    }

    pub fn create_template(
        name_hash: u256,
        category: u8,
        min_credits: u16,
        level: u8,
    ) -> u32 {
        let inst = self.institutions[msg.sender];
        require!(inst.registered, InstitutionNotRegistered {});
        require!(inst.accredited_until > block.timestamp, AccreditationExpired {});

        let id = self.template_count;
        self.template_count += 1;

        self.credential_templates[id] = CredentialTemplate {
            name_hash: name_hash,
            category: category,
            min_credits: min_credits,
            level: level,
            institution: msg.sender,
        };

        return id;
    }

    pub fn issue_credential(
        recipient: Address,
        template_id: u32,
        achievement_hash: u256,
        metadata_hash: u256,
        grade_points_x100: u16,
        credits: u16,
        validity_years: u64,
        prerequisites: Vec<u64>,
    ) -> u64 {
        let inst = self.institutions[msg.sender];
        require!(inst.registered, InstitutionNotRegistered {});
        require!(inst.accredited_until > block.timestamp, AccreditationExpired {});

        let template = self.credential_templates[template_id];
        require!(credits >= template.min_credits, InsufficientCredits {
            required: template.min_credits,
            earned: credits,
        });

        // Verify all prerequisites are held by recipient
        for i in 0..prerequisites.len() {
            let prereq_id = prerequisites[i];
            let prereq = self.credentials[prereq_id];
            require!(
                prereq.recipient == recipient && prereq.active && !self.revocations[prereq_id].revoked,
                PrerequisiteNotMet { required_id: prereq_id }
            );
        }

        let credential_id = self.next_credential_id;
        self.next_credential_id += 1;

        let expires_at = if validity_years > 0 {
            block.timestamp + (validity_years * 365 * 86400)
        } else {
            0u64
        };

        self.credentials[credential_id] = Credential {
            institution: msg.sender,
            recipient: recipient,
            template_id: template_id,
            achievement_hash: achievement_hash,
            metadata_hash: metadata_hash,
            issued_at: block.timestamp,
            expires_at: expires_at,
            grade_points_x100: grade_points_x100,
            credits: credits,
            level: template.level,
            active: true,
        };

        self.student_credentials[recipient].push(credential_id);
        self.credential_prerequisites[credential_id] = prerequisites;
        self.institutions[msg.sender].credentials_issued += 1;

        emit CredentialIssued {
            credential_id: credential_id,
            institution: msg.sender,
            recipient: recipient,
        };
        return credential_id;
    }

    pub fn revoke_credential(credential_id: u64, reason_hash: u256) {
        let cred = self.credentials[credential_id];
        require!(cred.institution == msg.sender || msg.sender == self.governance, NotIssuer {});
        require!(!self.revocations[credential_id].revoked, AlreadyRevoked {});

        self.revocations[credential_id] = RevocationInfo {
            revoked: true,
            revoked_at: block.timestamp,
            reason_hash: reason_hash,
            revoked_by: msg.sender,
        };
        self.credentials[credential_id].active = false;

        emit CredentialRevoked { credential_id: credential_id, reason_hash: reason_hash };
    }

    pub fn endorse_skill(recipient: Address, skill_hash: u256) {
        let current = self.skill_endorsements[recipient][skill_hash];
        self.skill_endorsements[recipient][skill_hash] = current + 1;
        emit SkillEndorsed { recipient: recipient, skill_hash: skill_hash, count: current + 1 };
    }

    pub fn share_transcript(viewer: Address, transcript_hash: u256) {
        self.transcript_hashes[msg.sender][viewer] = transcript_hash;
        emit TranscriptShared { student: msg.sender, viewer: viewer };
    }

    #[view]
    pub fn verify_credential(credential_id: u64) -> bool {
        let cred = self.credentials[credential_id];
        if !cred.active {
            return false;
        }
        if self.revocations[credential_id].revoked {
            return false;
        }
        if cred.expires_at > 0 && cred.expires_at < block.timestamp {
            return false;
        }
        let inst = self.institutions[cred.institution];
        return inst.registered;
    }

    #[view]
    pub fn get_credential(credential_id: u64) -> Credential {
        return self.credentials[credential_id];
    }

    #[view]
    pub fn get_institution(addr: Address) -> Institution {
        return self.institutions[addr];
    }

    #[view]
    pub fn get_endorsement_count(recipient: Address, skill_hash: u256) -> u32 {
        return self.skill_endorsements[recipient][skill_hash];
    }

    #[view]
    pub fn get_student_credential_count(student: Address) -> u64 {
        return self.student_credentials[student].len() as u64;
    }
}
