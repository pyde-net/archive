// Basic NFT contract with mint, transfer, burn, and metadata support.
// Implements a minimal non-fungible token standard on Pyde.

contract BasicNFT {
    storage {
        name: String,
        symbol: String,
        owner: Address,
        next_token_id: u256,
        owners: Map<u256, Address>,
        balances: Map<Address, u256>,
        token_uris: Map<u256, String>,
        approvals: Map<u256, Address>,
        operator_approvals: Map<Address, Map<Address, bool>>,
    }

    event Transfer {
        #[indexed]
        from: Address,
        #[indexed]
        to: Address,
        #[indexed]
        token_id: u256,
    }

    event Approval {
        #[indexed]
        owner: Address,
        #[indexed]
        approved: Address,
        #[indexed]
        token_id: u256,
    }

    event ApprovalForAll {
        #[indexed]
        owner: Address,
        #[indexed]
        operator: Address,
        approved: bool,
    }

    error TokenDoesNotExist { token_id: u256 }
    error NotOwnerOrApproved {}
    error TransferToZeroAddress {}
    error AlreadyMinted { token_id: u256 }
    error NotContractOwner {}
    error ApprovalToCurrentOwner {}
    error SelfApproval {}

    #[constructor]
    pub fn init(name: String, symbol: String) {
        self.name = name;
        self.symbol = symbol;
        self.owner = msg.sender;
        self.next_token_id = 1;
    }

    pub fn mint(to: Address, uri: String) {
        require!(msg.sender == self.owner, NotContractOwner {});
        require!(to != Address::ZERO, TransferToZeroAddress {});

        let token_id = self.next_token_id;
        self.next_token_id = token_id + 1;

        self.owners[token_id] = to;
        self.balances[to] = self.balances[to] + 1;
        self.token_uris[token_id] = uri;

        emit Transfer { from: Address::ZERO, to: to, token_id: token_id };
    }

    pub fn transfer_from(from: Address, to: Address, token_id: u256) {
        require!(self.exists(token_id), TokenDoesNotExist { token_id: token_id });
        require!(self.is_approved_or_owner(msg.sender, token_id), NotOwnerOrApproved {});
        require!(to != Address::ZERO, TransferToZeroAddress {});

        // Clear previous approval
        self.approvals[token_id] = Address::ZERO;

        self.balances[from] = self.balances[from] - 1;
        self.balances[to] = self.balances[to] + 1;
        self.owners[token_id] = to;

        emit Transfer { from: from, to: to, token_id: token_id };
    }

    pub fn approve(to: Address, token_id: u256) {
        let token_owner = self.owners[token_id];
        require!(self.exists(token_id), TokenDoesNotExist { token_id: token_id });
        require!(to != token_owner, ApprovalToCurrentOwner {});
        require!(
            msg.sender == token_owner || self.operator_approvals[token_owner][msg.sender],
            NotOwnerOrApproved {}
        );

        self.approvals[token_id] = to;
        emit Approval { owner: token_owner, approved: to, token_id: token_id };
    }

    pub fn set_approval_for_all(operator: Address, approved: bool) {
        require!(operator != msg.sender, SelfApproval {});
        self.operator_approvals[msg.sender][operator] = approved;
        emit ApprovalForAll { owner: msg.sender, operator: operator, approved: approved };
    }

    pub fn burn(token_id: u256) {
        require!(self.exists(token_id), TokenDoesNotExist { token_id: token_id });
        require!(self.is_approved_or_owner(msg.sender, token_id), NotOwnerOrApproved {});

        let token_owner = self.owners[token_id];
        self.approvals[token_id] = Address::ZERO;
        self.balances[token_owner] = self.balances[token_owner] - 1;
        self.owners[token_id] = Address::ZERO;
        self.token_uris[token_id] = "";

        emit Transfer { from: token_owner, to: Address::ZERO, token_id: token_id };
    }

    #[view]
    pub fn owner_of(token_id: u256) -> Address {
        require!(self.exists(token_id), TokenDoesNotExist { token_id: token_id });
        return self.owners[token_id];
    }

    #[view]
    pub fn balance_of(account: Address) -> u256 {
        return self.balances[account];
    }

    #[view]
    pub fn token_uri(token_id: u256) -> String {
        require!(self.exists(token_id), TokenDoesNotExist { token_id: token_id });
        return self.token_uris[token_id];
    }

    #[view]
    pub fn get_approved(token_id: u256) -> Address {
        require!(self.exists(token_id), TokenDoesNotExist { token_id: token_id });
        return self.approvals[token_id];
    }

    #[view]
    pub fn is_approved_for_all(owner: Address, operator: Address) -> bool {
        return self.operator_approvals[owner][operator];
    }

    #[view]
    pub fn total_supply() -> u256 {
        return self.next_token_id - 1;
    }

    fn exists(token_id: u256) -> bool {
        return self.owners[token_id] != Address::ZERO;
    }

    fn is_approved_or_owner(spender: Address, token_id: u256) -> bool {
        let token_owner = self.owners[token_id];
        return spender == token_owner
            || self.approvals[token_id] == spender
            || self.operator_approvals[token_owner][spender];
    }
}
